#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R                &kp T                                          &kp Y      &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D         &kp F                &kp G                           &kp MINUS      &kp H      &kp J  &kp K      &kp L    &kp ENTER
&kp Z      &kp X         &kp C         &kp V                &kp B            &kp UNDER      &kp SEMICOLON  &kp N      &kp M  &kp COMMA  &kp DOT  &kp LS(QUESTION)
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 2 RIGHT_BRACKET  &lt 3 BACKSLASH  &lt 5 MINUS    &lt 1 SPACE    &kp SPACE                             &kp RSHFT
            >;

            sensor-bindings =
                <&scroll_up_down>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_1 {
            bindings = <
&kp KP_NUMLOCK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_N9        &kp UNDER                    &kp SEMICOLON     &kp LEFT_BRACKET  &trans  &trans  &kp BSPC
&kp DQT         &kp KP_N4        &kp KP_N5        &kp KP_NUMBER_6  &kp COLON            &trans  &kp SQT           &trans            &trans  &trans  &kp LA(MINUS)
&kp FSLH        &kp KP_N1        &kp KP_NUMBER_2  &kp KP_N3        &kp MINUS  &trans    &trans  &kp LC(NUMBER_1)  &trans            &trans  &trans  &kp LS(QUESTION)
&kp LCTRL       &kp KP_N0        &kp DOT          &trans           &trans     &trans    &trans  &trans                                              &kp RSHFT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            bindings = <
&kp ESC           &kp LS(N1)  &kp LS(N2)  &kp LS(N3)         &kp LS(N4)                         &kp PAGE_UP    &kp AMPERSAND  &kp TILDE     &kp LEFT_PARENTHESIS  &kp DEL
&kp TAB           &kp LS(N5)  &kp LS(N6)  &kp LS(N7)         &kp LS(N8)               &kp HOME  &kp PAGE_DOWN  &kp AT_SIGN    &kp UP_ARROW  &kp DOLLAR            &kp LANGUAGE_2
&kp LEFT_SHIFT    &kp LS(N9)  &kp LS(N0)  &kp LS(BACKSLASH)  &kp PLUS    &kp EQUAL    &kp END   &kp SEMICOLON  &kp LEFT       &kp DOWN      &kp RIGHT             &trans
&kp LEFT_CONTROL  &trans      &kp LALT    &trans             &trans      &trans       &trans    &trans                                                            &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            bindings = <
&kp ESCAPE        &trans                  &kp UP_ARROW    &trans                   &trans                     &trans  &trans    &mkp MB4  &trans    &kp BACKSPACE
&kp TAB           &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END            &trans  &trans  &mkp MB1  &trans    &mkp MB2  &kp GRAVE
&kp LEFT_SHIFT    &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans    &trans  &trans  &trans    &mkp MB5  &trans    &kp FSLH
&kp LEFT_CONTROL  &trans                  &kp LEFT_ALT    &trans                   &trans   &trans    &trans  &trans                                &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_4 {
            bindings = <
&trans            &trans  &trans        &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans            &trans  &trans        &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans            &trans  &trans        &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&kp LEFT_CONTROL  &trans  &kp LEFT_ALT  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&kp F1     &kp F2   &kp F3    &kp F4   &trans                    &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT   &kp BSLH
&kp F5     &kp F6   &kp F7    &kp F8   &trans            &trans  &kp SEMI   &kp APOS   &kp ENTER  &kp COMMA  &kp DOT
&kp F9     &kp F10  &kp F11   &kp F12  &trans  &trans    &trans  &kp FSLH   &kp GRAVE  &trans     &trans     &trans
&kp LCTRL  &trans   &kp LALT  &trans   &trans  &trans    &trans  &trans                                      &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
